# ci-test-build.yml.template
# CI パイプライン: lint → test → build
#
# 前提条件:
#   - package.json に以下のスクリプトが定義されていること:
#     "lint": "eslint ." または "biome check ."
#     "test": "jest" または "vitest run"
#     "build": "next build" または "tsc" 等
#     "typecheck": "tsc --noEmit"（任意）
#
# カスタマイズ箇所（すべて置換必須）:
#   - {PACKAGE_MANAGER}: npm / pnpm / yarn
#   - {LOCK_FILE}: package-lock.json / pnpm-lock.yaml / yarn.lock
#   - {NODE_VERSION}: 20 / 22 等
#   - {MAIN_BRANCH}: このリポジトリの mainline ブランチ名（main / master / develop 等）。
#       確認: gh repo view --json defaultBranchRef -q .defaultBranchRef.name
#   - {DEV_BRANCH}: 開発ブランチ名（develop 等）。CI を mainline と開発ブランチの
#       2 本で回す運用向け。
#       ★ {MAIN_BRANCH} と必ず異なる名前にすること。
#       ★ 開発ブランチを持たない（mainline 1 本）なら、同じ名前を入れて重複させず
#         以下を削除する:
#           1) 下の on.push.branches / on.pull_request.branches の
#              '{DEV_BRANCH}' の 2 行
#           2) 本ヘッダの {DEV_BRANCH} 解説ブロック（この項目自体）
#              ★ 削除しないと、置換確認の grep 検査に {DEV_BRANCH} がコメントと
#                して引っかかり続け、正しく削除した人ほど検査に落ちる。
#
# 未置換のまま配置したときに何が起きるか（プレースホルダごとに違う。
# 「未置換＝いつも沈黙」ではない）:
#   - ブランチ名のプレースホルダ（branches に出るもの）→ 沈黙する
#       '{MAIN_BRANCH}' という実在しないブランチ名として扱われ、どの push / PR
#       にもマッチせず workflow が一切トリガーしない。GitHub 上でエラーにならず
#       チェックも赤くならないので「CI が無い」ことに気づきにくい。
#   - {PACKAGE_MANAGER} → workflow がトリガーされれば赤くなる（パース段階）
#       run: {PACKAGE_MANAGER} ... が YAML としてパースできず、GitHub が
#       workflow を invalid として拒否する。
#   - {LOCK_FILE} / {NODE_VERSION} → workflow がトリガーされれば赤くなる
#       （ステップ実行時）YAML は通るが、setup-node が不正なバージョン /
#       存在しないパスで失敗する。
#   ⚠️ 上記 2 つの「赤くなる」には成立条件がある——workflow がトリガーされること。
#     テンプレートをコピーして「何も置換しなかった」場合は branches も未置換なので
#     どのイベントにもマッチせず、赤が出る前に沈黙する側へ倒れうる。つまり
#     「赤くならない＝置換漏れは無い」とも「緑＝置換済み」とも判断できない。
#   ⚠️ 「ステップ実行時に赤」は YAML パースまでを実測した上での推論であって、
#     GitHub Actions 上で実走検証したものではない。配置後に必ず 1 度 mainline へ
#     変更を反映（PR を merge）し、run が実際に作られたことを確認する。

name: CI

on:
  push:
    branches:
      - '{MAIN_BRANCH}'
      - '{DEV_BRANCH}'
  pull_request:
    branches:
      - '{MAIN_BRANCH}'
      - '{DEV_BRANCH}'

# デフォルト権限を最小化
permissions:
  contents: read

jobs:
  # ============================================================
  # Job 1: lint（コードスタイル・静的解析）
  # ============================================================
  lint:
    name: Lint
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '{NODE_VERSION}'
          cache: '{PACKAGE_MANAGER}'
          cache-dependency-path: '{LOCK_FILE}'

      - name: Install dependencies
        run: {PACKAGE_MANAGER} install --frozen-lockfile
        # npm の場合: npm ci
        # yarn の場合: yarn install --immutable

      - name: Run lint
        run: {PACKAGE_MANAGER} run lint

      - name: Type check
        run: {PACKAGE_MANAGER} run typecheck
        # typecheck スクリプトがない場合は削除またはコメントアウト

  # ============================================================
  # Job 2: test（ユニットテスト・インテグレーションテスト）
  # ============================================================
  test:
    name: Test
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '{NODE_VERSION}'
          cache: '{PACKAGE_MANAGER}'
          cache-dependency-path: '{LOCK_FILE}'

      - name: Install dependencies
        run: {PACKAGE_MANAGER} install --frozen-lockfile

      - name: Run tests
        run: {PACKAGE_MANAGER} run test
        env:
          CI: true
          # テストで必要な環境変数を追加
          # NODE_ENV: test

      - name: Upload coverage report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: coverage-report
          path: coverage/
          retention-days: 7
        # coverage ディレクトリが存在しない場合は削除

  # ============================================================
  # Job 3: build（本番ビルド検証）
  # ============================================================
  build:
    name: Build
    runs-on: ubuntu-latest
    needs: [lint, test]  # lint と test が通過した場合のみ実行

    outputs:
      image-tag: ${{ steps.meta.outputs.version }}
      # Docker イメージを使用しない場合はこのセクションを削除

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '{NODE_VERSION}'
          cache: '{PACKAGE_MANAGER}'
          cache-dependency-path: '{LOCK_FILE}'

      - name: Install dependencies
        run: {PACKAGE_MANAGER} install --frozen-lockfile

      - name: Build
        run: {PACKAGE_MANAGER} run build
        env:
          NODE_ENV: production
          # ビルドで必要な環境変数を追加

      - name: Upload build artifacts
        uses: actions/upload-artifact@v4
        with:
          name: build-output
          path: |
            .next/
            dist/
            out/
          # ビルド出力ディレクトリをプロジェクトに合わせて変更
          retention-days: 1
          if-no-files-found: warn

