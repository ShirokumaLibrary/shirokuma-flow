# Mailpit service-fragment（AWS SES 相当のローカルメール捕捉）
# base に -f で合成して使う。SMTP でアプリが送ったメールを捕捉し Web UI で確認する。
# 使用方法:
#   ./scripts/dev-up.sh "-f compose.yaml -f compose.mailpit.yml"
#
# 置換変数:
#   {project}   - プロジェクト名（base と一致させる）
#
# .env.example に置く項目:
#   MAILPIT_SMTP_PORT=1025
#   MAILPIT_HTTP_PORT=8025
#
# アプリ側: SMTP ホスト=mailpit / ポート=1025（認証不要）。
#   本番 SES へは SES SMTP 認証情報に差し替え（env 切替）。Web UI は http://localhost:8025。
# compose-spec 準拠: `version:` キーは書かない。

services:
  mailpit:
    image: axllent/mailpit:v1.21   # バージョンピン（latest 禁止）
    container_name: {project}-mailpit
    restart: unless-stopped
    environment:
      - MP_SMTP_AUTH_ACCEPT_ANY=1       # ローカルは任意認証を受理（SES 認証は本番のみ）
      - MP_SMTP_AUTH_ALLOW_INSECURE=1
    ports:
      - "127.0.0.1:${MAILPIT_SMTP_PORT:-1025}:1025"   # SMTP 受信
      - "127.0.0.1:${MAILPIT_HTTP_PORT:-8025}:8025"    # Web UI
    healthcheck:
      test: ["CMD", "wget", "-q", "-O-", "http://localhost:8025/readyz"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - {project}-network

# ネットワークの top-level 宣言は base（compose.yaml）に任せ、fragment 側では宣言しない。
# fragment 側で `external: true` 宣言するとマージで base を上書きし
# ネットワーク事前作成が必須になる。宣言を省けば base が自動作成し合成 `up` がそのまま通る。
